---
const { contacto } = Astro.props;

const telLink = `tel:${contacto.phone}`;
const waLink = `https://wa.me/${contacto.whatsapp}`;
const mailLink = `mailto:${contacto.email}`;
---

<section class="contactanos" id="contacto">
  <div class="wrap">
    <h2 class="title">CONTÁCTANOS</h2>
    <span class="underline"></span>

    <div class="items">
      <a class="item" href={telLink} aria-label="Llámanos por teléfono">
        <span class="icon" aria-hidden="true">
          <!-- teléfono -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.15 12.8 19.86 19.86 0 0 1 .08 4.18 2 2 0 0 1 2.06 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L6.09 9.91a16 16 0 0 0 8 8l1.58-1.06a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Llámanos</span>
          <span class="sub">{contacto.phone}</span>
        </span>
      </a>

      <a class="item" href={waLink} target="_blank" rel="noreferrer" aria-label="Hablemos por WhatsApp">
        <span class="icon" aria-hidden="true">
          <!-- whatsapp (simple icon) -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.52 3.48A11.78 11.78 0 0 0 12.05 0C5.45 0 .14 5.31.14 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.33-1.66a11.86 11.86 0 0 0 5.72 1.46h.01c6.59 0 11.9-5.31 11.9-11.9 0-3.18-1.24-6.17-3.44-8.42z" stroke="none" fill="currentColor" opacity=".15"/>
            <path d="M7.2 6.9c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .6.5.2.5.8 2 .9 2.1.1.2.1.4 0 .6-.1.2-.2.3-.3.4l-.3.3c-.1.1-.2.3-.1.5.1.2.5 1 1.1 1.6.7.7 1.4 1 1.6 1.1.2.1.4 0 .5-.1l.5-.6c.2-.2.3-.2.5-.1.2.1 1.7.8 2 .9.3.1.5.2.6.3.1.1.1.7-.2 1.4-.3.7-1.2 1.3-1.6 1.3-.4 0-.7.1-2.3-.5-1.6-.6-2.6-1.8-3-2.2-.4-.4-1.6-2.1-1.6-4 0-1.9 1-2.8 1.4-3.2z"/>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Hablemos Por WhatsApp</span>
          <span class="sub">+{contacto.whatsapp}</span>
        </span>
      </a>

      <a class="item" href={mailLink} aria-label="Escríbenos por correo">
        <span class="icon" aria-hidden="true">
          <!-- mail -->
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16v16H4z"/>
            <path d="M22 6 12 13 2 6"/>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Escríbenos</span>
          <span class="sub">{contacto.email}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .contactanos{
    padding: 56px 0;
    background: #fff;
    border-bottom: 6px solid #0f2f68; 
  }

  .wrap{
    width: min(1100px, 92%);
    margin: 0 auto;
  }

  .title{
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: .5px;
  }

  .underline{
    display: inline-block;
    width: 130px;
    height: 3px;
    background: #6d28d9; 
    margin-top: 10px;
    border-radius: 999px;
  }

  .items{
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: center;
  }

  .item{
    display: flex;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 10px 6px;
    border-radius: 12px;
  }

  .item:hover{
    background: rgba(15,47,104,.06);
  }

  .icon{
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #0f2f68; /* azul oscuro */
    color: #fff;
    display: grid;
    place-items: center;
    flex: 0 0 56px;
  }

  .text{
    display: grid;
    gap: 2px;
  }

  .heading{
    font-weight: 800;
    font-size: 14px;
  }

  .sub{
    font-size: 12px;
    color: #4b5563;
  }

  @media (max-width: 860px){
    .items{
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>