              stroke-width="1.5"></path>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Hablemos Por WhatsApp</span>
          <span class="sub">+{contacto.whatsapp}</span>
        </span>
      </a>

      <a class="item" href={mailLink} aria-label="Escríbenos por correo">
        <span class="icon" aria-hidden="true">
          <!-- mail -->
          <svg
            width="24"
            height="18"
            viewBox="0 0 24 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M21 0H3C2.20435 0 1.44129 0.316068 0.878677 0.878677C0.316068 1.44129 0 2.20435 0 3V14.25C0 15.0456 0.316068 15.8087 0.878677 16.3713C1.44129 16.9339 2.20435 17.25 3 17.25H21C21.7956 17.25 22.5587 16.9339 23.1213 16.3713C23.6839 15.8087 24 15.0456 24 14.25V3C24 2.20435 23.6839 1.44129 23.1213 0.878677C22.5587 0.316068 21.7956 0 21 0ZM22.5 14.25C22.5 14.6478 22.342 15.0294 22.0607 15.3107C21.7794 15.592 21.3978 15.75 21 15.75H3C2.60218 15.75 2.22064 15.592 1.93934 15.3107C1.65803 15.0294 1.5 14.6478 1.5 14.25V3C1.5 2.60218 1.65803 2.22064 1.93934 1.93934C2.22064 1.65803 2.60218 1.5 3 1.5H21C21.3978 1.5 21.7794 1.65803 22.0607 1.93934C22.342 2.22064 22.5 2.60218 22.5 3V14.25Z"
              fill="white"></path>
            <path
              d="M19.7775 3.92262L12 10.2826L4.22247 3.92262C4.06752 3.82009 3.88003 3.77872 3.69633 3.80653C3.51262 3.83434 3.34578 3.92935 3.22813 4.07315C3.11047 4.21695 3.05038 4.39931 3.0595 4.58489C3.06861 4.77046 3.14629 4.94604 3.27747 5.07761L11.5275 11.8276C11.6611 11.936 11.8279 11.9952 12 11.9952C12.172 11.9952 12.3389 11.936 12.4725 11.8276L20.7225 5.07761C20.8099 5.01974 20.8843 4.94417 20.9407 4.85577C20.9972 4.76737 21.0345 4.66811 21.0501 4.56441C21.0658 4.46072 21.0596 4.35488 21.0319 4.25374C21.0041 4.1526 20.9555 4.0584 20.8891 3.97723C20.8226 3.89606 20.74 3.82971 20.6463 3.78248C20.5527 3.73526 20.4501 3.7082 20.3454 3.70305C20.2406 3.69791 20.136 3.7148 20.0381 3.75262C19.9403 3.79043 19.8515 3.84835 19.7775 3.92262Z"
              fill="white"></path>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Escríbenos</span>
          <span class="sub">{contacto.email}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .contactanos {
    padding: 56px 0;
    background: #fff;
    border-bottom: 6px solid #0f2f68;
  }

  .wrap {
    width: min(1100px, 92%);
    margin: 0 auto;
  }

  .title {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  .underline {
    display: inline-block;
    width: 130px;
    height: 3px;
    background: #6d28d9;
    margin-top: 10px;
    border-radius: 999px;
  }

  .items {
    margin: 34px 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    align-items: center;
  }

  .item {
    display: flex;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 10px 6px;
    border-radius: 12px;
  }

  .item:hover {
    background: rgba(15, 47, 104, 0.06);
  }

  .icon {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #0f2f68; /* azul oscuro */
    color: #fff;
    display: grid;
    place-items: center;
    flex: 0 0 56px;
  }

  .text {
    display: grid;
    gap: 2px;
  }

  .heading {
    font-weight: 800;
    font-size: 14px;
  }

  .sub {
    font-size: 12px;
    color: #4b5563;
  }

  @media (max-width: 860px) {
    .items {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
