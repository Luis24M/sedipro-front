              fill="white"></path>
          </svg>
        </span>
        <span class="text">
          <span class="heading">Llámanos</span>
          <span class="sub">{contacto.phone}</span>
        </span>
      </a>

      <a
        class="item"
        href={waLink}
        target="_blank"
        rel="noreferrer"
        aria-label="Hablemos por WhatsApp"
      >
        <span class="icon" aria-hidden="true">
          <!-- whatsapp (simple icon) -->
          <svg
            width="26"
            height="26"
            viewBox="0 0 26 26"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
