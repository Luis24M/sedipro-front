---
import Title from '@/components/ui/Title.astro';

const { contacto } = Astro.props;

const telLink = `tel:${contacto.phone}`;
const waLink = `https://wa.me/${contacto.whatsapp}`;
const mailLink = `mailto:${contacto.email}`;
---

<section class="section-content" id="contacto">
  <div class="wrap">
    <Title title="CONTÁCTANOS" />

    <div class="items">
      <a class="item" href={telLink} aria-label="Llámanos por teléfono">
        <span class="icon" aria-hidden="true">
          <!-- teléfono -->
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
