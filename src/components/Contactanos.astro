              stroke="white"
              stroke-width="1.5"></path>
            <path
              d="M17.627 14.2711C17.1182 14.0167 16.7465 13.8601 16.4823 13.7623C16.316 13.7036 15.9246 13.5275 15.7877 13.6351C15.3572 13.9873 14.8973 14.9853 14.4081 15.1712C13.1949 14.9364 12.0698 14.1047 11.1893 13.2535C10.7979 12.8817 10.0739 11.8251 9.91736 11.5414C9.888 11.2478 10.4163 10.8565 10.5337 10.6315C11.1403 9.9466 10.6805 9.51611 10.6022 9.23238C10.4653 8.93886 10.2304 8.41054 10.025 7.98005C9.84888 7.69632 9.8097 7.27561 9.49662 7.11907C8.16602 6.4342 7.40292 7.80394 7.08984 8.51816C5.20155 13.0676 16.5508 21.7263 18.8598 15.7582C18.9772 15.2397 18.9283 15.044 18.7521 14.8092C18.3999 14.5646 17.989 14.4569 17.627 14.2711Z"
