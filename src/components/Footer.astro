---
const currentYear = new Date().getFullYear();
---

<footer class="bg-blue-lineal text-white w-full">
  <div class="px-[43px] py-[36px] flex flex-col items-center text-center">
    
    <div class="flex flex-col items-center gap-[71px] w-full max-w-[1444px]">
      
      <!-- Logo -->
      <img src="/Imagenes/logo_blanco.png" alt="Logo Sedipro" class="h-16 md:h-20 w-auto" />

      <!-- Bloque Dirección -->
      <div class="flex flex-col gap-2">
        <h3 class="text-18 font-bold">Dirección:</h3>
        <a
          href="https://maps.app.goo.gl/XCtZjwdm1NRrLxL66"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 text-16 text-neutral-100 hover:text-white transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <p>Jiron Alfonso Ugarte 402, Trujillo</p>
        </a>
      </div>

      <!-- Bloque Contacto -->
      <div class="flex flex-col gap-2">
        <h3 class="text-18 font-bold">Contacto:</h3>
        <div class="flex flex-col gap-1 text-16 text-neutral-100">
          <a href="tel:+51986756970" class="flex items-center justify-center gap-2 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>+51 986 756 970</span>
          </a>
          <a href="mailto:sedipro@unitru.edu.pe" class="flex items-center justify-center gap-2 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>sedipro@unitru.edu.pe</span>
          </a>
        </div>
      </div>

      <!-- Redes Sociales -->
      <div class="flex flex-col gap-4">
        <h3 class="text-18 font-bold">Síguenos en:</h3>
        <div class="flex justify-center gap-6">

          <!-- Facebook -->
          <a href="https://www.facebook.com/SediproUNT" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:text-light-blue-300 transition-colors">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a href="https://www.instagram.com/sediprount/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-light-blue-300 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>

          <!-- YouTube -->
          <a href="https://www.youtube.com/c/SEDIPROUNT" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="hover:text-light-blue-300 transition-colors">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33zM9.75 15.02V8.48L15.45 11.75l-5.7 3.27z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href="https://pe.linkedin.com/company/sediprount" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-light-blue-300 transition-colors">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 1-2 2 2 2 0 0 1 2-2z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a href="https://www.tiktok.com/@sediprount" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="hover:text-light-blue-300 transition-colors">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
            </svg>
          </a>

        </div>
      </div>
    </div>

    <!-- Separador -->
    <div class="w-full max-w-[1358px] border-t border-white/20 mt-[71px] mb-8"></div>

    <!-- Copyright -->
    <p class="text-14 font-medium">
      Copyright © {currentYear} SEDIPRO UNT
    </p>
  </div>
</footer>