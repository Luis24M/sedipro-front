---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

// Datos para las columnas del footer
const navLinks = [
  { name: "Inicio", href: "/" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Logros", href: "#logros" },
  { name: "Noticias", href: "#noticias" },
];

const communityLinks = [
  { name: "Directiva", href: "#directiva" },
  { name: "Aliados", href: "#aliados" },
  { name: "Preguntas Frecuentes", href: "#faq" },
  { name: "Contacto", href: "#contacto" },
];
---

<footer class="bg-primary-500 text-white pt-16 pb-8 mt-auto">
  <div class="main-container">
    <!-- Grid Principal: 1 columna en móvil, 2 en tablet, 4 en desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      
      <!-- Columna 1: Logo y Descripción -->
      <div class="flex flex-col gap-6">
        <img src="/Imagenes/logo_blanco.png" alt="Logo Sedipro" class="h-14 w-fit object-contain" />
        <p class="text-14 text-neutral-200 leading-relaxed">
          Sección Estudiantil de Dirección de Proyectos de la Universidad Nacional de Trujillo. 
          Potenciando líderes bajo estándares globales del PMI.
        </p>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="flex flex-col gap-4">
        <h3 class="text-h4 text-light-blue-300 uppercase tracking-wider font-bold">Navegación</h3>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-14 text-neutral-100 hover:text-secondary-100 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Comunidad -->
      <div class="flex flex-col gap-4">
        <h3 class="text-h4 text-light-blue-300 uppercase tracking-wider font-bold">Comunidad</h3>
        <ul class="flex flex-col gap-3">
          {communityLinks.map((link) => (
            <li>
              <a href={link.href} class="text-14 text-neutral-100 hover:text-secondary-100 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 4: Redes Sociales -->
      <div class="flex flex-col gap-4">
        <h3 class="text-h4 text-light-blue-300 uppercase tracking-wider font-bold">Síguenos</h3>
        <div class="flex gap-4">
          <!-- Facebook -->
          <a href="#" class="bg-white/10 p-3 rounded-full hover:bg-secondary-200 transition-all hover:-translate-y-1" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="#" class="bg-white/10 p-3 rounded-full hover:bg-secondary-200 transition-all hover:-translate-y-1" aria-label="Instagram">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <!-- LinkedIn -->
          <a href="#" class="bg-white/10 p-3 rounded-full hover:bg-secondary-200 transition-all hover:-translate-y-1" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Línea divisoria y Copyright -->
    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-12 text-neutral-400">
      <p>© {currentYear} SEDIPRO UNT. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>