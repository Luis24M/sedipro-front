---
import TitleNavBarSection from "@/components/ui/TitleNavBarSection.astro";

const { background, isSection } = Astro.props;
---
<header class={`top-0 left-0 w-full z-[90] py-6 ${isSection ? 'block opacity-100 px-5 sm:px-16 md:px-24' : 'absolute'}`} style={`background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), ${background};`}>
  <div class={`main-container flex justify-between items-center ${isSection ? 'max-w-7xl mx-auto' : ''}`}>
    <!-- Logo -->
    <a href="/" class={`transition-transform hover:scale-105 ${isSection ? 'hidden' : ''}`}>
      <img src="/Imagenes/logo_blanco.png" alt="Logo Sedipro" class="h-10 md:h-12 w-auto" />
    </a>
    <TitleNavBarSection title="Noticias" path="Inicio / Noticias" show={isSection}/>
    <!-- Botón Hamburguesa -->
    <button id="open-menu" class="text-white p-2 focus:outline-none cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>
