---
import Title from '@/components/ui/Title.astro';
---

<section id="nosotros" class="bg-primary-50">
  <div class="section-content">
    <!-- Título Principal -->
    <Title title="Nosotros" />

    <div class="mb-10 lg:mb-16">
      <h3 class="text-18 md:text-h3 font-semibold text-neutral-1000 mb-3">
        ¿Quiénes somos?
      </h3>
      <p class="text-neutral-700 text-14 md:text-base leading-relaxed">
        Somos la Sección Estudiantil de Dirección de Proyectos de la Universidad
        Nacional de Trujillo, equipo multidisciplinario orientado a difundir las
        buenas prácticas en gestión de proyectos con metodología PMI y
        herramientas ágiles, bajo 3 enfoques, académico, social y ambiental.
      </p>
    </div>

    <!-- Misión y Visión Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <!-- Nuestra Misión -->
      <div class="flex flex-col">
        <div class="flex items-start gap-3 mb-3">
          <!-- Ícono Misión -->
          <svg
            class="w-7 h-7 md:w-8 md:h-8 shrink-0 mt-1"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="16"
              cy="16"
              r="15"
              stroke="#9636ad"
              stroke-width="2"
              fill="none"></circle>
            <circle
              cx="16"
              cy="16"
              r="10"
              stroke="#9636ad"
              stroke-width="2"
              fill="none"></circle>
            <circle
              cx="16"
              cy="16"
              r="5"
              stroke="#9636ad"
              stroke-width="2"
              fill="none"></circle>
            <circle cx="16" cy="16" r="2" fill="#9636ad"></circle>
          </svg>
          <div class="flex flex-col">
            <h4 class="text-16 md:text-h4 font-semibold text-primary-500 mb-2">
              Nuestra Misión
            </h4>
            <p class="text-neutral-700 text-14 md:text-base leading-relaxed">
              Formar a los futuros líderes en las buenas prácticas de Dirección
              de Proyectos bajo un enfoque integral e innovador
            </p>
          </div>
        </div>
      </div>

      <!-- Nuestra Visión -->
      <div class="flex flex-col">
        <div class="flex items-start gap-3 mb-3">
          <!-- Ícono Visión - Cohete despegando -->
          <svg
            class="w-7 h-7 md:w-8 md:h-8 shrink-0 mt-1"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Cuerpo del cohete -->
            <path
              d="M16 4L18 12L20 16L18 20L16 24L14 20L12 16L14 12L16 4Z"
              fill="#9636ad"></path>

            <circle cx="16" cy="14" r="2" fill="#E6F4FF"></circle>
            <path d="M12 16L8 20L12 22L12 16Z" fill="#9636ad"></path>
            <path d="M20 16L24 20L20 22L20 16Z" fill="#9636ad"></path>

            <path
              d="M14 24L14 27L16 28L18 27L18 24"
              stroke="#9636ad"
              stroke-width="1.5"
              stroke-linecap="round"
              fill="none"></path>
          </svg>
          <div class="flex flex-col">
            <h4 class="text-16 md:text-h4 font-semibold text-primary-500 mb-2">
              Nuestra Visión
            </h4>
            <p class="text-neutral-700 text-14 md:text-base leading-relaxed">
              Ser la mejor SEDIPRO a nivel nacional a partir de los mejores
              gestores de proyectos.
            </p>
          </div>
        </div>
      </div>

      <!-- Valores -->
      <div class="flex flex-col">
        <div class="flex items-start gap-3 mb-3">
          <!-- Ícono Valores - Corazón -->
          <div class="w-7 h-7 md:w-8 md:h-8 shrink-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#9636ad"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-school w-full h-full shrink-0 mt-1"
              ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                d="M22 9l-10 -4l-10 4l10 4l10 -4v6"></path><path
                d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4"></path></svg
            >
          </div>
          <div class="flex flex-col">
            <h4 class="text-16 md:text-h4 font-semibold text-primary-500 mb-2">
              Nuestros Valores
            </h4>
            <ul
              class="[&>li]:text-neutral-700 [&>li]:text-14 [&>li]:md:text-base [&>li]:leading-relaxed flex flex-col gap-1"
            >
              <li>Actitud Positiva - Innovación</li>
              <li>Integridad - Trabajo en Equipo</li>
              <li>Vocación de Servicio</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
