---
import Title from '@/components/ui/Title.astro';
import {NoticiasCarousel} from '@/components/ui/NoticiasCarousel';

const { noticias } = Astro.props;
---

<section id="noticias" class="section-content">
  <Title title="Noticias" />
  <NoticiasCarousel client:visible noticias={noticias} />
  
</section>
