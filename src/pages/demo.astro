---
import Layout from '@/layouts/Layout.astro';
import { getDemo } from '@/services/demo.service';
const demo = await getDemo();
---

<Layout>
  <main
    class="flex justify-center items-center flex-col h-full bg-accent-50/80"
  >
    <div class="bg-primary-50/85 p-4 rounded-2xl">
      <div>
        {
          demo.map(({ number, label }) => (
            <span class="mx-2">
              {number} {label}
            </span>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
