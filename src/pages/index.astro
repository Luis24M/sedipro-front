---
import Layout from '@/layouts/Layout.astro';
import {
	Welcome,
	Nosotros,
	Logros,
	Reconocimientos,
	Directiva,
	Aliados,
	ProximosEventos,
	Noticias,
	PreguntasFrecuentes,
	Contactanos,
} from '@/components';

import { getLogros } from "@/services/logros.service";
import { getPartners } from '@/services/partner.service';

const logrosData = await getLogros();
const partnersData = await getPartners();
---

<Layout>
	<Welcome />
	<Nosotros />
	<Logros items={logrosData} />
	<Reconocimientos />
	<Directiva />
	<Aliados partners={partnersData}/>
	<ProximosEventos />
	<Noticias />
	<PreguntasFrecuentes />
	<Contactanos />
</Layout>
