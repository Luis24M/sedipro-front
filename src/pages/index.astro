---
import Layout from '@/layouts/Layout.astro';
import { getLogros } from "@/services/logros.service";
import { getContacto } from "@/services/contactanos.service";

import {
	Welcome,
	Nosotros,
	Logros,
	Reconocimientos,
	Directiva,
	Aliados,
	ProximosEventos,
	Noticias,
	PreguntasFrecuentes,
	Contactanos,
	Footer,
} from '@/components';

const logrosData = await getLogros();
const contactoData = await getContacto();

---

<Layout>
	<Welcome />
	<Nosotros />
	<Logros items={logrosData} />
	<Reconocimientos />
	<Directiva />
	<Aliados />
	<ProximosEventos />
	<Noticias />
	<PreguntasFrecuentes />
    <Contactanos contacto={contactoData} />	
</Layout>
