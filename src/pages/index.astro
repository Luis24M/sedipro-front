---
import Layout from '@/layouts/Layout.astro';
import { getLogros } from "@/services/logros.service";

import {
	Welcome,
	Nosotros,
	Logros,
	Reconocimientos,
	Directiva,
	Aliados,
	ProximosEventos,
	Noticias,
	PreguntasFrecuentes,
	Contactanos,
	Footer,
} from '@/components';

const logrosData = await getLogros();
---

<Layout>
	<Welcome />
	<Nosotros />
	<Logros items={logrosData} />
	<Reconocimientos />
	<Directiva />
	<Aliados />
	<ProximosEventos />
	<Noticias />
	<PreguntasFrecuentes />
	<Contactanos />
	<Footer />
</Layout>
