---
import Layout from '@/layouts/Layout.astro';
import {
	Welcome,
	Nosotros,
	Logros,
	Reconocimientos,
	Directiva,
	Aliados,
	ProximosEventos,
	Noticias,
	PreguntasFrecuentes,
	Contactanos,
} from '@/components';

import { getLogros } from "@/services/logros.service";
import { getPartners } from '@/services/partner.service';
import { getNoticias } from '@/services/noticia.service';
import { getPreguntas} from '@/services/preguntas.service';
import { getContacto } from '@/services/contactanos.service';
import { getDirectiva } from '@/services/directiva.service';
import { getEventos } from '@/services/evento.service';

const logrosData = await getLogros();
const directivaData = await getDirectiva();
const contactoData = await getContacto();
const partnersData = await getPartners();
const noticiasData = await getNoticias();
const preguntasData = await getPreguntas();
const eventosData = await getEventos();
---

<Layout>
	<Welcome />
	<Nosotros />
	<Logros items={logrosData} />
	<Reconocimientos />
	<Directiva directiva={directivaData} />
	<Aliados partners={partnersData}/>
	<ProximosEventos eventos={eventosData} />
	<Noticias noticias={noticiasData} />
	<PreguntasFrecuentes preguntas={preguntasData}/>
	<Contactanos contacto={contactoData} />
</Layout>
