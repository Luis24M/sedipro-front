---
import { DateNoticia } from '@/components/ui/DateNoticia';
import Layout from '@/layouts/Layout.astro';
import { getNoticiaById, getNoticias } from '@/services/noticia.service';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((noticia) => ({
    params: { slug: noticia.id.toString() }
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('ID de noticia no proporcionado');
}

const id = parseInt(slug);
const noticia = await getNoticiaById(id);
---

<Layout
  backgroundNavBar="url('/Imagenes/banner-noticias.png')"
  isSection={true}
  title={noticia.name}
  description={noticia.longDescription}
  imageUrl={noticia.image_url}
>
  <section class="section-content">
    <img
      src={noticia.image_url}
      alt={noticia.name}
      class="w-full h-auto rounded-lg mb-4"
    />
    <DateNoticia date={noticia.publishDate} />
    <h1 class="text-3xl font-bold mb-4">{noticia.name}</h1>
    <p class="text-lg text-gray-800">{noticia.longDescription}</p>

    <!-- Compartir -->
    <h4 class="mt-6 text-gray-600">Ver publicación en:</h4>
    <div class="mt-2 flex items-center gap-4">

      <!-- Facebook: link directo a la publicación -->
      <a
        href={noticia.facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver en Facebook"
      >
        <img src="/icons/facebook.svg" alt="Facebook" />
      </a>

      <!-- LinkedIn: link directo a la publicación -->
      <a
        href={noticia.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver en LinkedIn"
      >
        <img src="/icons/linkedin.svg" alt="LinkedIn" />
      </a>

      <!-- Copiar enlace -->
      <button id="copy-btn" class="text-gray-600 hover:text-gray-800" aria-label="Copiar enlace">
        <img src="/icons/link.svg" alt="Copiar URL" />
      </button>

    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('copy-btn');

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.innerHTML = '✔';
      setTimeout(() => {
        btn.innerHTML = '<img src="/icons/link.svg" alt="Copiar URL" />';
      }, 2000);
    } catch (err) {
      console.error('Error copiando enlace', err);
    }
  });
</script>